{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/api/run/route.ts": {
      "maxDuration": 300
    },
    "app/api/cron/cold-mail-suppression/route.ts": {
      "maxDuration": 120
    },
    "app/api/cron/cold-mail-warming/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/cron/weekly-digest?dry=0", "schedule": "0 8 * * 2" },
    { "path": "/api/cron/cold-mail-suppression", "schedule": "15 * * * *" },
    { "path": "/api/cron/cold-mail-warming", "schedule": "0 9 * * 1-5" }
  ]
}
