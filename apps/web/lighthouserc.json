{
  "ci": {
    "collect": {
      "startServerCommand": "npm start",
      "startServerReadyPattern": "ready|started|Ready",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://127.0.0.1:3400/",
        "http://127.0.0.1:3400/audit",
        "http://127.0.0.1:3400/leaderboard",
        "http://127.0.0.1:3400/docs",
        "http://127.0.0.1:3400/blog",
        "http://127.0.0.1:3400/mcp-oauth-checklist",
        "http://127.0.0.1:3400/scanning"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "/leaderboard$",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.6 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.9 }],
            "categories:best-practices": ["warn", { "minScore": 0.85 }]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.8 }],
            "categories:accessibility": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["warn", { "minScore": 0.9 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
