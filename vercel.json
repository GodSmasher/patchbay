{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @patchbay-nebius/audit-core && npm run build -w @patchbay-nebius/agent && npm run build -w @patchbay-nebius/web",
  "outputDirectory": "apps/web/.next",
  "functions": {
    "app/api/run/route.ts":                       { "maxDuration": 300 },
    "app/api/cron/cold-mail-suppression/route.ts": { "maxDuration": 120 },
    "app/api/cron/cold-mail-warming/route.ts":    { "maxDuration": 300 },
    "app/api/cron/ingest-discovery/route.ts":     { "maxDuration": 60 },
    "app/api/cron/validated-prune/route.ts":      { "maxDuration": 60 }
  },
  "schedules": {
    "weekly-digest":         { "schedule": "0 8 * * 2",   "path": "/api/cron/weekly-digest?dry=0",   "requestMethod": "GET" },
    "cold-mail-suppression": { "schedule": "15 * * * *",  "path": "/api/cron/cold-mail-suppression", "requestMethod": "GET" },
    "cold-mail-warming":     { "schedule": "0 9 * * 1-5", "path": "/api/cron/cold-mail-warming",     "requestMethod": "GET" },
    "ingest-discovery":      { "schedule": "30 * * * *",  "path": "/api/cron/ingest-discovery",      "requestMethod": "GET" },
    "validated-prune":       { "schedule": "45 * * * *",  "path": "/api/cron/validated-prune",       "requestMethod": "GET" }
  }
}
