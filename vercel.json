{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w @patchbay/agent && npm run build -w @patchbay/web",
  "outputDirectory": "apps/web/.next",
  "functions": {
    "apps/web/app/api/run/route.ts": {
      "maxDuration": 300
    },
    "apps/web/app/api/slack/command/route.ts": {
      "maxDuration": 300
    }
  }
}
