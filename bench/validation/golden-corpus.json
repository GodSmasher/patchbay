{
  "description": "Golden corpus for patchbay audit-core validation. Each case specifies a TargetSnapshot shape and the finding IDs expected to fire. Used by scripts/validate-golden-corpus.ts to measure per-check FP/FN rates across the full ALL_CHECKS pipeline.",
  "cases": [
    {
      "name": "clean-tier1-no-oauth",
      "description": "Public MCP server with no OAuth, strong headers, clean tool descriptions. Only HEADERS-001 info-level signals possible.",
      "snapshot": {
        "kind": "remote-url",
        "target": "https://clean.example/mcp",
        "capturedAt": "2026-11-24T00:00:00Z",
        "remote": {
          "url": "https://clean.example/mcp",
          "reachable": true,
          "usesTls": true,
          "initializeOk": true,
          "toolsListOk": true,
          "authRequired": false,
          "acceptedAuthHeader": "none",
          "transport": "streamable-http",
          "tools": [{"name": "search", "description": "Search public records."}],
          "originValidation": "strict",
          "redirectLocalhostInconsistent": false,
          "responseHeaders": {
            "strict-transport-security": "max-age=31536000; includeSubDomains; preload",
            "x-content-type-options": "nosniff",
            "x-frame-options": "DENY",
            "content-security-policy": "frame-ancestors 'none'"
          },
          "publicByDesign": true,
          "publicByDesignEvidence": "initialize returned 200 without Authorization header",
          "rawErrors": []
        }
      },
      "expectedFindings": ["AUTH-001"]
    },
