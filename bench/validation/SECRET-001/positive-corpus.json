{
  "$schema": "https://patchbay-mcp.dev/schemas/validation-corpus.json",
  "checkId": "SECRET-001",
  "kind": "positive",
  "description": "Strings that the SECRET-001 scanner MUST flag. Each entry is a file body; after probeDirectory runs, the referenced pattern must appear in secretHits.",
  "cases": [
    {
      "name": "real-shape-openai-key",
      "file": "client.ts",
      "content": "const apiKey = \"sk-ABCDEFGHIJKLMNopqrstuv0123456789ABCDEFGHIJKLMNop\"\n",
      "expectPattern": "openai-key"
    },
    {
      "name": "real-shape-openai-proj-key",
      "file": "client.ts",
      "content": "const key = \"sk-proj-AbCdEfGhIjKlMnOpQrStUvWxYz0123456789AbCdEfGhIj\"\n",
      "expectPattern": "openai-key"
    },
    {
      "name": "real-shape-slack-bot-token",
      "file": "server.ts",
      "content": "const slack = \"xoxb-1234567890123-9876543210987-aBcDeFgHiJkLmNoPqRsT\"\n",
      "expectPattern": "slack-bot-token"
    },
    {
      "name": "real-shape-aws-access-key",
      "file": "cfg.py",
      "content": "AWS_ACCESS_KEY_ID = \"AKIAABCDEF1234567890\"\n",
      "expectPattern": "aws-access-key"
    },
    {
      "name": "real-shape-github-classic-pat",
      "file": "release.ts",
      "content": "const gh = \"ghp_abcdefghijklmnopqrstuvwxyz0123456789ABCD\"\n",
      "expectPattern": "github-token"
    },
    {
      "name": "generic-hex-secret-assignment",
      "file": "settings.js",
      "content": "const password = \"a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6\"\n",
      "expectPattern": "generic-hex-secret"
    }
  ]
}
