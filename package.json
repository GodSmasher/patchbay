{
  "name": "patchbay",
  "private": true,
  "description": "Describe an integration in one sentence, get a tested TypeScript connector. Nemotron on Nebius Token Factory, Tavily for API docs, Nebius Sandboxes for verification.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "validate:secret-001": "tsx scripts/validate-secret-001.ts",
    "validate:finding-schema": "tsx scripts/validate-finding-schema.ts",
    "validate:process-001": "tsx scripts/validate-process-001.ts",
    "validate": "npm run validate:secret-001 && npm run validate:finding-schema && npm run validate:process-001",
    "sync:dashboard": "tsx scripts/sync-dashboard-data.ts",
    "agent": "tsx --env-file-if-exists=.env.local packages/agent/src/cli.ts",
    "patchbay": "tsx --env-file-if-exists=.env.local packages/agent/src/cli.ts",
    "mcp": "tsx --env-file-if-exists=.env.local packages/mcp/src/server.ts",
    "check:nebius": "tsx --env-file-if-exists=.env.local scripts/check-nebius.ts",
    "fixture": "tsx scripts/build-fixture.ts",
    "bench": "tsx --env-file-if-exists=.env.local scripts/benchmark.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
