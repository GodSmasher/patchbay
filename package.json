{
  "name": "patchbay",
  "private": true,
  "description": "Describe an integration in one sentence, get a tested TypeScript connector. Nemotron on Nebius Token Factory, Tavily for API docs, Nebius Sandboxes for verification.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "agent": "tsx --env-file-if-exists=.env.local packages/agent/src/cli.ts",
    "check:nebius": "tsx --env-file-if-exists=.env.local scripts/check-nebius.ts",
    "fixture": "tsx scripts/build-fixture.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
