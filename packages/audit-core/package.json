{
  "name": "@patchbay-nebius/audit-core",
  "version": "0.8.0",
  "description": "Audit MCP servers and connectors for OAuth 2.1 / scope / secret gaps. Pure, I/O-free checks.",
  "keywords": [
    "patchbay",
    "mcp",
    "model-context-protocol",
    "oauth",
    "security",
    "audit",
    "audit-tool",
    "scanner"
  ],
  "author": "Sarah Vogel <vogels671@gmail.com>",
  "license": "MIT",
  "homepage": "https://patchbay-mcp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodSmasher/patchbay.git",
    "directory": "packages/audit-core"
  },
  "bugs": {
    "url": "https://github.com/GodSmasher/patchbay/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
