{
  "name": "@patchbay-nebius/agent",
  "version": "0.2.2",
  "description": "patchbay CLI: audit MCP servers for OAuth 2.1 gaps and build tested TypeScript/Python connectors from one-line prompts.",
  "keywords": [
    "patchbay",
    "codegen",
    "connector",
    "integration",
    "nebius",
    "nemotron",
    "tavily",
    "sandbox",
    "typescript",
    "agent"
  ],
  "author": "Sarah Vogel <vogels671@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/GodSmasher/patchbay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodSmasher/patchbay.git",
    "directory": "packages/agent"
  },
  "bugs": {
    "url": "https://github.com/GodSmasher/patchbay/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "patchbay": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@patchbay-nebius/audit-core": "^0.1.2",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
