# Raw sweep JSONs may contain unredacted critical findings on named vendors.
# Only aggregated/anonymized sweeps go into git (bench/*-aggregate.json).
bench/mcp-sweep-*.json
!bench/mcp-sweep-*-aggregate.json

# Cohort research artifacts of embargoed CVEs (verb breakdowns, pseudo
# samples). Even pseudonymized host slugs can be re-identified via
# brand-prefixed tool names, so these stay local for the disclosure window.
bench/auth-001-verb-breakdown.json
bench/auth-00*-verb-breakdown.json
bench/auth-00*-sample-pseudo.json
bench/auth-00*-cohort-*.json

# scratchpad holds disclosure drafts and other local notes — never committed.
scratchpad/

# Internal coordinated-disclosure log (contains embargoed finding details)
bench/disclosures.md
bench/disclosures/

# Impersonation report names orgs; keep local until investigated
bench/impersonation-report.json

# Generated at build by copy-bench.mjs
apps/web/data/
# ... except the discovery-queue consumed by /api/cron/ingest-discovery
# and the prune-list consumed by /api/cron/validated-prune.
!apps/web/data/discovery-queue.json
!apps/web/data/prune-list.json

# Crawl artifacts live in patchbay-ops; this is a transient scratch location during a crawl
pilot-outputs/
.lighthouseci/
