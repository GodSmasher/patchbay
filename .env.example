# Copy to .env.local and fill in. Without keys patchbay runs in replay mode
# (a recorded run is streamed back), so the UI and tests work offline.

# "false" switches to live mode (real Nemotron, Tavily and Sandbox calls).
PATCHBAY_MOCK=true

# Nebius Token Factory: one key covers inference and Sandboxes.
NEBIUS_API_KEY=
NEBIUS_AI_PROJECT=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_SANDBOX_URL=https://api.tokenfactory.nebius.com/sandboxes/v1

# Model tiers (override if the catalog ids differ in your project).
PATCHBAY_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
PATCHBAY_MODEL_MID=nvidia/nemotron-3-super-120b-a12b
PATCHBAY_MODEL_STRONG=nvidia/Nemotron-3-Ultra-550b-a55b

# Pointing at a different OpenAI-compatible provider:
#   PATCHBAY_LLM_PROVIDER=openai     (strips the Nemotron thinking flag so OpenAI accepts the body)
#   PATCHBAY_LLM_BASE_URL=https://api.openai.com/v1
#   PATCHBAY_LLM_API_KEY=sk-...
#   PATCHBAY_MODEL_FAST=gpt-4o-mini
#   PATCHBAY_MODEL_MID=gpt-4o-mini
#   PATCHBAY_MODEL_STRONG=gpt-4o
# Any OpenAI-compatible endpoint works the same way (Groq, Together, Fireworks, OpenRouter,
# self-hosted vLLM) — just swap the base URL and the model ids.

# Tavily: web search + page extraction for API docs.
TAVILY_API_KEY=

# Optional: reuse a prepared sandbox image (node + vitest installed) across runs.
PATCHBAY_BASE_IMAGE=

# Live-mode guard for the public demo.
PATCHBAY_MAX_RUNS_PER_HOUR=6

# Where drafts are verified: "nebius" (isolated Nebius sandbox, default) or
# "local" (dev fallback: tsc + vitest on this machine, not isolated).
PATCHBAY_RUNNER=nebius

# Repair-loop knobs.
PATCHBAY_MAX_ATTEMPTS=4
# Fan-out: generate N repair candidates per attempt (different temperatures),
# verify them in parallel sandbox forks, keep the first green one. 1 = classic
# sequential repair. Caps at 4. Burns ~N× the strong-model tokens for every
# repair cycle; 2 is the current default (hits 95%+ green on the 20-prompt
# benchmark without blowing up cost).
PATCHBAY_PARALLEL_REPAIRS=2
