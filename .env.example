# Copy to .env.local and fill in. Without keys patchbay runs in replay mode
# (a recorded run is streamed back), so the UI and tests work offline.

# "false" switches to live mode (real Nemotron, Tavily and Sandbox calls).
PATCHBAY_MOCK=true

# Nebius Token Factory: one key covers inference and Sandboxes.
NEBIUS_API_KEY=
NEBIUS_AI_PROJECT=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_SANDBOX_URL=https://api.tokenfactory.nebius.com/sandboxes/v1

# Model tiers (override if the catalog ids differ in your project).
PATCHBAY_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
PATCHBAY_MODEL_MID=nvidia/nemotron-3-super-120b-a12b
PATCHBAY_MODEL_STRONG=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily: web search + page extraction for API docs.
TAVILY_API_KEY=

# Optional: reuse a prepared sandbox image (node + vitest installed) across runs.
PATCHBAY_BASE_IMAGE=

# Live-mode guard for the public demo.
PATCHBAY_MAX_RUNS_PER_HOUR=6
